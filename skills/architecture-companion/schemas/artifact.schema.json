{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./artifact.schema.json",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "vcs": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "divergesFromRevision": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "divergesFromRevision"
      ],
      "additionalProperties": false
    },
    "generator": {
      "type": "string",
      "pattern": "^(?:built-in|project|global):[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "readOnly": true,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Link"
      }
    },
    "diagram": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "layout": {
              "type": "object",
              "properties": {
                "layoutId": {
                  "type": "string",
                  "const": "elk-layered"
                },
                "options": {
                  "type": "object",
                  "properties": {
                    "nudgeObstacleNodes": {
                      "type": "boolean"
                    },
                    "bezierEdges": {
                      "type": "boolean"
                    },
                    "elk": {
                      "$ref": "#/$defs/ElkOptions"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "layoutId"
              ],
              "additionalProperties": false
            },
            "graph": {
              "$ref": "#/$defs/DiagramGraph"
            }
          },
          "required": [
            "layout",
            "graph"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "layout": {
              "type": "object",
              "properties": {
                "layoutId": {
                  "type": "string",
                  "const": "sequence"
                }
              },
              "required": [
                "layoutId"
              ],
              "additionalProperties": false
            },
            "graph": {
              "$ref": "#/$defs/SequenceGraph"
            }
          },
          "required": [
            "layout",
            "graph"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "layout": {
              "type": "object",
              "properties": {
                "layoutId": {
                  "type": "string",
                  "const": "dependency-graph"
                }
              },
              "required": [
                "layoutId"
              ],
              "additionalProperties": false
            },
            "graph": {
              "$ref": "#/$defs/DependencyGraph"
            }
          },
          "required": [
            "layout",
            "graph"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "layout": {
              "type": "object",
              "properties": {
                "layoutId": {
                  "type": "string",
                  "const": "component-structure"
                },
                "options": {
                  "type": "object",
                  "properties": {
                    "elk": {
                      "$ref": "#/$defs/ElkOptions"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "layoutId"
              ],
              "additionalProperties": false
            },
            "graph": {
              "$ref": "#/$defs/ComponentStructureGraph"
            }
          },
          "required": [
            "layout",
            "graph"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "artifactId",
    "title",
    "updatedAt",
    "generator",
    "instructions",
    "diagram"
  ],
  "additionalProperties": false,
  "$defs": {
    "Link": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "href"
      ],
      "additionalProperties": false
    },
    "ElkOptions": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "UP",
            "DOWN",
            "LEFT",
            "RIGHT"
          ]
        },
        "layered.edgeRouting": {
          "type": "string",
          "enum": [
            "ORTHOGONAL",
            "POLY_LINE",
            "SPLINES"
          ]
        },
        "layered.nodePlacement.strategy": {
          "type": "string",
          "enum": [
            "BRANDES_KOEPF",
            "LINEAR_SEGMENTS",
            "SIMPLE",
            "MIN_WIDTH",
            "INTERACTIVE"
          ]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "DiagramGraph": {
      "type": "object",
      "properties": {
        "groups": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "nodes": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/DefaultNode"
              },
              {
                "$ref": "#/$defs/LifelineNode"
              },
              {
                "$ref": "#/$defs/FragmentNode"
              }
            ]
          }
        },
        "edges": {
          "readOnly": true,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/DefaultEdge"
              },
              {
                "$ref": "#/$defs/ControlEdge"
              },
              {
                "$ref": "#/$defs/MessageEdge"
              }
            ]
          }
        }
      },
      "required": [
        "groups",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "Group": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parentGroupId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "groupId",
        "title"
      ],
      "additionalProperties": false
    },
    "DefaultNode": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "default"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        }
      },
      "required": [
        "nodeId",
        "title",
        "type"
      ],
      "additionalProperties": false
    },
    "LifelineNode": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "lifeline"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "activations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "activationId": {
                "type": "string",
                "minLength": 1
              },
              "startsAt": {
                "type": "object",
                "properties": {
                  "messageId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "endpoint": {
                    "type": "string",
                    "enum": [
                      "source",
                      "target"
                    ]
                  }
                },
                "required": [
                  "messageId",
                  "endpoint"
                ],
                "additionalProperties": false
              },
              "endsAt": {
                "type": "object",
                "properties": {
                  "messageId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "endpoint": {
                    "type": "string",
                    "enum": [
                      "source",
                      "target"
                    ]
                  }
                },
                "required": [
                  "messageId",
                  "endpoint"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "activationId",
              "startsAt",
              "endsAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "nodeId",
        "title",
        "kind",
        "type",
        "activations"
      ],
      "additionalProperties": false
    },
    "FragmentNode": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "fragment"
        },
        "operator": {
          "type": "string",
          "enum": [
            "alt",
            "opt",
            "loop",
            "par",
            "break",
            "critical",
            "assert",
            "neg"
          ]
        },
        "branches": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "branchId": {
                "type": "string",
                "minLength": 1
              },
              "guard": {
                "type": "string",
                "minLength": 1
              },
              "startMessageId": {
                "type": "string",
                "minLength": 1
              },
              "endMessageId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "branchId",
              "guard",
              "startMessageId",
              "endMessageId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "nodeId",
        "title",
        "kind",
        "type",
        "operator",
        "branches"
      ],
      "additionalProperties": false
    },
    "DefaultEdge": {
      "type": "object",
      "properties": {
        "edgeId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "default"
        },
        "sourceNodeId": {
          "type": "string",
          "minLength": 1
        },
        "targetNodeId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "edgeId",
        "type",
        "sourceNodeId",
        "targetNodeId"
      ],
      "additionalProperties": false
    },
    "ControlEdge": {
      "type": "object",
      "properties": {
        "edgeId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "control"
        },
        "sourceNodeId": {
          "type": "string",
          "minLength": 1
        },
        "targetNodeId": {
          "type": "string",
          "minLength": 1
        },
        "activeWhen": {
          "$ref": "#/$defs/RouteRequirementRuleset"
        }
      },
      "required": [
        "edgeId",
        "type",
        "sourceNodeId",
        "targetNodeId",
        "activeWhen"
      ],
      "additionalProperties": false
    },
    "RouteRequirementRuleset": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "controlId": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "controlId",
            "value"
          ],
          "additionalProperties": false
        }
      }
    },
    "MessageEdge": {
      "type": "object",
      "properties": {
        "edgeId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "message"
        },
        "sourceNodeId": {
          "type": "string",
          "minLength": 1
        },
        "targetNodeId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "messageType": {
          "default": "sync",
          "type": "string",
          "enum": [
            "sync",
            "async",
            "return"
          ]
        }
      },
      "required": [
        "edgeId",
        "type",
        "sourceNodeId",
        "targetNodeId"
      ],
      "additionalProperties": false
    },
    "SequenceGraph": {
      "type": "object",
      "properties": {
        "groups": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "nodes": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/LifelineNode"
              },
              {
                "$ref": "#/$defs/FragmentNode"
              }
            ]
          }
        },
        "edges": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessageEdge"
          }
        }
      },
      "required": [
        "groups",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "DependencyGraph": {
      "type": "object",
      "properties": {
        "groups": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "nodes": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/DefaultNode"
          }
        },
        "edges": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/DefaultEdge"
          }
        }
      },
      "required": [
        "groups",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "ComponentStructureGraph": {
      "type": "object",
      "properties": {
        "groups": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "nodes": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "groupId": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "default"
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Link"
                }
              },
              "layoutContext": {
                "type": "object",
                "properties": {
                  "definitionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "origins": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ComponentOrigin"
                    }
                  }
                },
                "required": [
                  "definitionId",
                  "origins"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "nodeId",
              "title",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "readOnly": true,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/ComponentStructureDefaultEdge"
              },
              {
                "$ref": "#/$defs/ComponentStructureControlEdge"
              }
            ]
          }
        },
        "layoutContext": {
          "type": "object",
          "properties": {
            "rootNodeIds": {
              "readOnly": true,
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "controls": {
              "readOnly": true,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "controlId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "ownerNodeId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dependsOn": {
                        "$ref": "#/$defs/RouteRequirementRuleset"
                      },
                      "type": {
                        "type": "string",
                        "const": "conditional"
                      }
                    },
                    "required": [
                      "controlId",
                      "ownerNodeId",
                      "label",
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "controlId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "ownerNodeId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dependsOn": {
                        "$ref": "#/$defs/RouteRequirementRuleset"
                      },
                      "type": {
                        "type": "string",
                        "const": "branch"
                      },
                      "cases": {
                        "minItems": 2,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "caseId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "caseId",
                            "label"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "polarityPair": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "controlId",
                      "ownerNodeId",
                      "label",
                      "type",
                      "cases"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "auxiliaryDefinitions": {
              "readOnly": true,
              "type": "array",
              "items": {
                "$ref": "#/$defs/AuxiliaryDefinition"
              }
            }
          },
          "required": [
            "rootNodeIds",
            "controls"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "groups",
        "nodes",
        "edges",
        "layoutContext"
      ],
      "additionalProperties": false
    },
    "ComponentOrigin": {
      "type": "object",
      "properties": {
        "supplierDefinitionId": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "supplierDefinitionId",
        "slot"
      ],
      "additionalProperties": false
    },
    "ComponentStructureDefaultEdge": {
      "type": "object",
      "properties": {
        "edgeId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "default"
        },
        "sourceNodeId": {
          "type": "string",
          "minLength": 1
        },
        "targetNodeId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "layoutContext": {
          "$ref": "#/$defs/ComponentStructureEdgeLayoutContext"
        }
      },
      "required": [
        "edgeId",
        "type",
        "sourceNodeId",
        "targetNodeId"
      ],
      "additionalProperties": false
    },
    "ComponentStructureEdgeLayoutContext": {
      "type": "object",
      "properties": {
        "composition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentComposition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ComponentComposition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "node",
            "render",
            "component"
          ]
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentOrigin"
          }
        }
      },
      "required": [
        "type",
        "origins"
      ],
      "additionalProperties": false
    },
    "ComponentStructureControlEdge": {
      "type": "object",
      "properties": {
        "edgeId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
