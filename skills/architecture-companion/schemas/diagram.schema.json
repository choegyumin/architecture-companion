{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./diagram.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "string",
      "pattern": "^(?:built-in|project|global):[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "elk-layered"
            },
            "options": {
              "type": "object",
              "properties": {
                "nudgeObstacleNodes": {
                  "type": "boolean"
                },
                "bezierEdges": {
                  "type": "boolean"
                },
                "elk": {
                  "type": "object",
                  "properties": {
                    "direction": {
                      "type": "string",
                      "enum": [
                        "UP",
                        "DOWN",
                        "LEFT",
                        "RIGHT"
                      ]
                    },
                    "layered.edgeRouting": {
                      "type": "string",
                      "enum": [
                        "ORTHOGONAL",
                        "POLY_LINE",
                        "SPLINES"
                      ]
                    },
                    "layered.nodePlacement.strategy": {
                      "type": "string",
                      "enum": [
                        "BRANDES_KOEPF",
                        "LINEAR_SEGMENTS",
                        "SIMPLE",
                        "MIN_WIDTH",
                        "INTERACTIVE"
                      ]
                    }
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "sequence"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "dependency-graph"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "links": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "href"
        ],
        "additionalProperties": false
      }
    },
    "graph": {
      "$ref": "./diagram-graph.schema.json"
    }
  },
  "required": [
    "id",
    "title",
    "generator",
    "instructions",
    "layout",
    "graph"
  ],
  "additionalProperties": false
}
