{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./config.schema.json",
  "type": "object",
  "properties": {
    "artifactPatterns": {
      "default": [
        "**/*.archcomp.json"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "placementInstructions": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
