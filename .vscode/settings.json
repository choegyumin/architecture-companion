{
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "never",
    "source.sortImports": "never",
    "source.organizeLinkDefinitions": "never"
  },
  "editor.formatOnSave": true,
  "files.readonlyInclude": {
    "skills/architecture-companion/schemas/**": true,
    "skills/architecture-companion/runtime/**": true
  },
  "files.watcherExclude": {
    "skills/architecture-companion/schemas/**": true,
    "skills/architecture-companion/runtime/**": true
  },
  "tailwindCSS.classFunctions": ["classnames", "clsx", "cn", "cva", "cx", "twMerge", "cns"],
  "files.associations": {
    ".env": "properties",
    ".env.*": "properties",
    ".dev.vars": "properties",
    ".dev.vars.*": "properties",
    "*.css": "tailwindcss",
    "*ignore": "ignore"
  }
}
