{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./diagram-graph.schema.json",
  "type": "object",
  "properties": {
    "groups": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "parentId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "readOnly": true,
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "groupId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "default"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "href": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "href"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "title",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "groupId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "lifeline"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "href": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "href"
                  ],
                  "additionalProperties": false
                }
              },
              "activations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "startsAt": {
                      "type": "object",
                      "properties": {
                        "messageId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "endpoint": {
                          "type": "string",
                          "enum": [
                            "source",
                            "target"
                          ]
                        }
                      },
                      "required": [
                        "messageId",
                        "endpoint"
                      ],
                      "additionalProperties": false
                    },
                    "endsAt": {
                      "type": "object",
                      "properties": {
                        "messageId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "endpoint": {
                          "type": "string",
                          "enum": [
                            "source",
                            "target"
                          ]
                        }
                      },
                      "required": [
                        "messageId",
                        "endpoint"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "startsAt",
                    "endsAt"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "type",
              "activations"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "groupId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "fragment"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "alt",
                  "opt",
                  "loop",
                  "par",
                  "break",
                  "critical",
                  "assert",
                  "neg"
                ]
              },
              "branches": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "guard": {
                      "type": "string",
                      "minLength": 1
                    },
                    "startMessageId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "endMessageId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "guard",
                    "startMessageId",
                    "endMessageId"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "type",
              "operator",
              "branches"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "edges": {
      "readOnly": true,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "default"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "source",
              "target"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "message"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              },
              "messageType": {
                "default": "sync",
                "type": "string",
                "enum": [
                  "sync",
                  "async",
                  "return"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "source",
              "target"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "groups",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
