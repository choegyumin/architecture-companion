{
  "name": "architecture-companion",
  "version": "0.1.0",
  "author": "Alvin Gyumin Choi <choegyumin@gmail.com>",
  "contributors": [
    "Alvin Gyumin Choi <choegyumin@gmail.com>"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "dev": "concurrently --no-color --kill-others --success first --names server,client \"pnpm dev.server\" \"pnpm dev.client\"",
    "dev.server": "tsx watch --clear-screen=false --exclude \"src/client/**\" --exclude \"src/**/*.tsx\" scripts/start-dev-server.ts",
    "dev.client": "wait-on tcp:127.0.0.1:4318 && vite --open",
    "build": "tsx scripts/generate-schemas.ts --check && tsx scripts/clean-dist.ts && tsup && vite build && tsx scripts/compose-dist.ts && tsx scripts/verify-dist.ts",
    "schema-gen": "tsx scripts/generate-schemas.ts",
    "start": "node dist/serve.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write --no-error-on-unmatched-pattern .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@base-ui/utils": "^0.3.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^1.19.13",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "hono": "^4.12.32",
    "lucide-react": "^1.34.0",
    "overlay-kit": "^1.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.6.9",
    "concurrently": "^10.0.5",
    "eslint-import-resolver-oxc": "^0.15.0",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-turbo": "^2.8.14",
    "happy-dom": "^20.8.3",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  }
}
